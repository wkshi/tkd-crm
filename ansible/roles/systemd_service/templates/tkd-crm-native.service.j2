[Unit]
Description={{ app_name }} (Node.js)
Documentation=https://github.com/wkshi/tkd-crm
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=tkd-crm
Group=tkd-crm
WorkingDirectory={{ deploy_dir }}

# 环境变量
Environment=NODE_ENV=production
Environment=DOCKER_DEPLOY=true
Environment=PORT={{ app_port }}
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# 启动命令：先执行数据库迁移，再启动应用
ExecStartPre=/usr/bin/bash -c "cd {{ deploy_dir }} && npx prisma migrate deploy"
ExecStart=/usr/bin/node {{ deploy_dir }}/.next/standalone/server.js

# 重启策略
Restart=always
RestartSec=5

# 资源限制（可选）
# MemoryLimit=512M
# CPUQuota=100%

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tkd-crm

[Install]
WantedBy=multi-user.target
