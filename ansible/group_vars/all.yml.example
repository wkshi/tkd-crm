# ─── 跆拳道馆 CRM 全局变量 ───
# 复制 all.yml.example 为 all.yml 并填写实际值
# 此文件已被 .gitignore 排除，请勿手动添加到 Git

# ── 应用配置 ──
app_name: "跆拳道馆 CRM"
app_version: "1.0.0"

# ── 部署目录 ──
deploy_dir: /opt/tkd-crm

# ── 服务端口 ──
app_port: 3000
db_port: 5432

# ── 数据库配置 ──
postgres_user: taekwondo
# ⚠️ 请修改为强密码
postgres_password: CHANGE_ME_TO_STRONG_PASSWORD
postgres_db: taekwondo_crm
# ── PostgreSQL 系统路径配置 ──
# 以下默认值为 Fedora 默认仓库路径，其他 RedHat 系发行版请按实际情况覆盖
postgresql_service_name: postgresql
postgresql_data_dir: "/var/lib/pgsql/data"
postgresql_bin_dir: "/usr/bin"
postgresql_packages:
  - postgresql-server
  - postgresql-contrib

# ── AI 模型配置 ───
model: "openai:gpt-4o"

# ── AI 提供商 API Key（至少配置一个）───
openai_api_key: ""
anthropic_api_key: ""
google_api_key: ""
deepseek_api_key: ""
groq_api_key: ""

# ── 自定义 OpenAI 兼容端点（可选）───
custom_openai_base_url: ""
custom_openai_api_key: ""

# ── 健康检查配置 ──
health_check_retries: 12
health_check_delay: 5
